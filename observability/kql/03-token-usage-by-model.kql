// Token Usage by Model
// Placeholders: {TimeRange} is supplied by the workbook time picker.
// Tables: ApimAiGateway_CL (usage), ApimClientOwnership_CL (who owns each app),
//         ApimModelRate_CL (price per 1k tokens), ApimTeamBudget_CL (monthly budget).

let Ownership=ApimClientOwnership_CL
| summarize arg_max(TimeGenerated,*) by ClientId
| project ClientId,Own_App=AppName,Own_Team=Team,Own_CC=CostCenter,Own_BU=BusinessUnit;

let Rates=ApimModelRate_CL
| summarize arg_max(TimeGenerated,*) by ModelName;

let Base=ApimAiGateway_CL
| where TimeGenerated {TimeRange}
| lookup kind=leftouter Ownership on $left.Appid==$right.ClientId
| extend Team=coalesce(Own_Team,'UNATTRIBUTED'),CostCenter=coalesce(iif(isempty(CostCenterClaim),tostring(Own_CC),CostCenterClaim),'UNKNOWN'),BusinessUnit=coalesce(iif(isempty(BusinessUnitClaim),tostring(Own_BU),BusinessUnitClaim),'UNKNOWN'),AppName=coalesce(Own_App,Appid),AttributionSource=iif(isnotempty(CostCenterClaim),'B:jwt-claim','A:lookup');

Base
| summarize PromptTokens=sum(PromptTokens),CompletionTokens=sum(CompletionTokens) by ModelName
| sort by PromptTokens desc
